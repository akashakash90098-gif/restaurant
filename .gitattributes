# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary files - preserve exact bytes
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.svg binary
*.mp4 binary
*.ico binary

